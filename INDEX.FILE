<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Secret Message </title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;

    background:url('mikasa.jpg.jfif');
    background-size:contain;
    background-repeat:no-repeat;
    background-position:center;
    background-color:black;

    font-family:Arial,sans-serif;
}

.box{
    background:rgba(0,0,0,0.6);
    padding:30px;
    border-radius:20px;
    text-align:center;
    color:white;
    width:320px;
}

h2{
    margin-bottom:15px;
}

input{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    font-size:16px;
}

button{
    margin-top:12px;
    padding:10px 20px;
    border:none;
    border-radius:10px;
    background:#ff4d94;
    color:white;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:#ff1a75;
}

#message{
    display:none;
    margin-top:20px;
    font-size:28px;
    color:#ff99cc;
    font-weight:bold;
    text-shadow:0 0 10px #ff66b2;
}
</style>
</head>

<body>

<div class="box">
    <h2>Enter Your Name </h2>

    <input type="text" id="nameInput" placeholder="Type your name">

    <br><br>

    <button onclick="checkName()">Open</button>

    <div id="message">
        BISHHH,<br>
        I LOVE U 
    </div>
</div>

<script>
function checkName(){

    let name = document.getElementById("nameInput").value.trim();

    if(name.toLowerCase() === "ayesha"){
        document.getElementById("message").style.display = "block";
    } else {
        alert("Only Ayesha can open this ");
    }
}
</script>

</body>
</html>
